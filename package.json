{
  "name": "dosya-duzenleyici",
  "productName": "Dosya Duzenleyici Pro",
  "version": "3.2.0",
  "description": "Dosya düzenleme ve organizasyon uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.dosyaduzenleyici.pro",
    "files": [
      "**/*",
      "!tailwindcss.exe"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "portable"
    }
  },
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.8.0",
    "material-symbols": "^0.46.0"
  }
}
